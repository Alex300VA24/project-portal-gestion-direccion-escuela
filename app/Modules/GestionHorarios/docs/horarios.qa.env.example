# Plantilla documental SOLO para QA aislado. No cargar como .env institucional.
# Las guardas usan getenv(): exportar las variables en cada PowerShell.
# Sustituir marcadores localmente; no guardar credenciales en Git.
APP_ENV=testing
APP_URL=http://127.0.0.1:8001
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=PUERTO_POSTGRES_LOCAL
DB_DATABASE=horarios_demo_2026_ii_demanda
DB_USERNAME=USUARIO_QA_PRIVADO
DB_PASSWORD=
# DB_URL: comprobar que no se herede una conexión a otra base.
HORARIOS_DEMO_PLAN=QA-HORARIOS
HORARIOS_QA_CONSULTAS=1
HORARIOS_DEMO_ARCHIVO=RUTA_PRIVADA_JSON_AUTORIZADO
HORARIOS_QA_PYTHON=RUTA_ABSOLUTA_PYTHON_VENV
HORARIOS_DEMO_NOMBRES_REALES=0
HORARIOS_QA_LECTORES=
HORARIOS_QA_DOCENTES=
# Formato lectores: alumno@example.invalid;profesor@example.invalid
# Formato docentes: profesor@example.invalid=ID_DOCENTE_QA
# Fuera de QA: no activar HORARIOS_QA_CONSULTAS ni usar estos valores.
